<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ShareMoto Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-container">
      <aside class="sidebar glass-panel">
        <div class="sidebar-header">
          <h2>ShareMoto</h2>
          <span class="badge">Admin</span>
        </div>
        <nav class="sidebar-nav">
          <%= link_to "Dashboard", root_path, class: "nav-item #{'active' if current_page?(root_path)}" %>
          <%= link_to "Utilisateurs", users_path, class: "nav-item #{'active' if current_page?(users_path)}" %>
          <%= link_to "Vérifications", verifications_path, class: "nav-item #{'active' if current_page?(verifications_path)}" %>
        </nav>
      </aside>
      
      <main class="main-content">
        <header class="topbar glass-panel">
          <div class="search-bar">
            <input type="text" placeholder="Rechercher..." />
          </div>
          <div class="user-profile">
            <span>Admin</span>
            <div class="avatar">A</div>
          </div>
        </header>
        
        <div class="content-wrapper">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
